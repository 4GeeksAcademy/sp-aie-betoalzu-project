# ---------------------------------------------------------------------------
# Backend — Authentication & Security
# ---------------------------------------------------------------------------

# Secret key used to sign JWT tokens. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# JWT algorithm (default: HS256)
ALGORITHM=HS256

# JWT access token expiration in minutes (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Password reset token expiration in minutes (default: 30)
RESET_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# Email — Resend
# ---------------------------------------------------------------------------

# API key for Resend transactional email service. Get yours at https://resend.com
RESEND_API_KEY=

# Sender email address for outgoing emails (must be verified in Resend)
FROM_EMAIL=noreply@nexova.com

# ---------------------------------------------------------------------------
# Frontend URL (used in password reset email links)
# ---------------------------------------------------------------------------

# URL of the frontend application, used to build password reset links
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Backend URL (used by the Next.js proxy)
# ---------------------------------------------------------------------------

# Python backend URL (Docker: http://backend:8000, local: http://localhost:8000)
API_URL=http://backend:8000
BACKEND_URL=http://backend:8000
# ---------------------------------------------------------------------------
# Database — PostgreSQL / Supabase (opcional, si no se define usa SQLite)
# ---------------------------------------------------------------------------
DATABASE_URL=

NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events

EMBED_MODEL=madrid-spain/openrouter/perplexity/pplx-embed-v1-0.6b
EMBED_BASE_URL=https://llm.4geeks.ai
EMBED_MODEL_API_KEY=
EMBEDDING_DIMENSION=1024

LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# ---------------------------------------------------------------------------
# RAG — Knowledge Base (Qdrant vector store)
# ---------------------------------------------------------------------------

# Qdrant vector database URL (Docker: http://qdrant:6333, local: http://localhost:6333)
QDRANT_URL=http://localhost:6333

# Minimum similarity score threshold for retrieval (default: 0.5)
RAG_MIN_SCORE=0.5
