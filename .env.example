# ---------------------------------------------------------------------------
# Backend — Authentication & Security
# ---------------------------------------------------------------------------

# Secret key used to sign JWT tokens. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# JWT algorithm (default: HS256)
ALGORITHM=HS256

# JWT access token expiration in minutes (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Password reset token expiration in minutes (default: 30)
RESET_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# Email — Resend
# ---------------------------------------------------------------------------

# API key for Resend transactional email service. Get yours at https://resend.com
RESEND_API_KEY=

# Sender email address for outgoing emails (must be verified in Resend)
FROM_EMAIL=noreply@nexova.com

# ---------------------------------------------------------------------------
# Frontend URL (used in password reset email links)
# ---------------------------------------------------------------------------

# URL of the frontend application, used to build password reset links
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Backend URL (used by the Next.js proxy)
# ---------------------------------------------------------------------------

# Python backend URL (default: http://localhost:8000)
API_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000
# ---------------------------------------------------------------------------
# Database — PostgreSQL / Supabase (opcional, si no se define usa SQLite)
# ---------------------------------------------------------------------------
DATABASE_URL=
